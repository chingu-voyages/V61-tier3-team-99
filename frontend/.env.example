# Supabase project URL and publishable key (Settings -> API in the Supabase dashboard).
# Used for GitHub sign-in, the leaderboard, and word selection (get_random_word /
# get_hourly_word RPCs, see supabase/migrations/0002_words.sql). The publishable
# key is safe to expose client-side (subject to RLS) -- never put the secret key
# here. Without these set, Infinity Mode falls back to a client-side word list,
# but the Live Challenge (Hourly) mode requires them -- there's no equivalent
# fallback for it, since a client-generated word would break the "same word for
# everyone" guarantee.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
