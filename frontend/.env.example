# Supabase project URL and publishable key (Settings -> API in the Supabase dashboard).
# Used for GitHub sign-in and the leaderboard. The publishable key is safe to
# expose client-side (subject to RLS) -- never put the secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
